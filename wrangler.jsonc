{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tokai-kisen-forecast",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-09-28",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "triggers": {
    "crons": ["0 */2 * * *"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tokai-kisen-forecast-local",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "env": {
    "preview": {
      "name": "tokai-kisen-forecast-preview",
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "tokai-kisen-forecast-preview",
          "database_id": "00000000-0000-0000-0000-000000000000",
          "migrations_dir": "migrations"
        }
      ]
    },
    "production": {
      "name": "tokai-kisen-forecast-production",
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "tokai-kisen-forecast-production",
          "database_id": "00000000-0000-0000-0000-000000000000",
          "migrations_dir": "migrations"
        }
      ]
    }
  }
}
